# ---- Segurança e canônico ----
RewriteEngine On

# Bloquear acesso direto a configs e artefatos sensiveis
RewriteRule ^config(/|$) - [F,L]
RewriteRule (^|/)\.(env|git|svn) - [F,L]
RewriteRule \.(sql|zip|bak|old|orig|backup)$ - [F,L]

# Forçar HTTPS + sem www (ajuste se quiser com www)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.ferrisoisolamentos\.com\.br$ [NC]
RewriteRule ^ https://ferrisoisolamentos.com.br%{REQUEST_URI} [L,R=301]

# URLs públicas limpas: redireciona .php para a versão canônica sem extensão.
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/+(sobre|areas|produtos|portfolio|avaliacoes|contato|privacidade)\.php[\s?] [NC]
RewriteRule ^(sobre|areas|produtos|portfolio|avaliacoes|contato|privacidade)\.php$ /$1 [L,R=301]
RewriteCond %{THE_REQUEST} \s/+newsletter/confirm\.php[\s?] [NC]
RewriteRule ^newsletter/confirm\.php$ /newsletter/confirm [L,R=301]

# Evita duas versões da mesma página com e sem barra final.
RewriteRule ^(sobre|areas|produtos|portfolio|avaliacoes|contato|privacidade)/$ /$1 [L,R=301]

# Rewrites internos: arquivos PHP continuam sendo executados no servidor.
RewriteRule ^(sobre|areas|produtos|portfolio|avaliacoes|contato|privacidade)$ $1.php [L]
RewriteRule ^forms/contato_enviar$ forms/contato_enviar.php [L]
RewriteRule ^newsletter/(subscribe|confirm)$ newsletter/$1.php [L]

# Sua 404
ErrorDocument 404 /404.php

# ---- Noindex por cabeçalho p/ áreas sensíveis ----
# /admin, /painel, /login (e seus subcaminhos)
RewriteRule ^(admin|painel|login)(/.*)?$ - [E=NOINDEX:1]

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive" env=NOINDEX
</IfModule>
